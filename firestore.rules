rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUserRole() { return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userDoc().data.role : null; }
    function isAdmin() { return getUserRole() == 'ADMIN'; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    function inventoryValid() {
      return request.resource.data.quantity is number &&
        request.resource.data.reservedQuantity is number &&
        request.resource.data.reorderLevel is number &&
        request.resource.data.quantity >= 0 &&
        request.resource.data.reservedQuantity >= 0 &&
        request.resource.data.reorderLevel >= 0 &&
        request.resource.data.reservedQuantity <= request.resource.data.quantity;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /manufacturers/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /distributors/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /pharmacies/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /hospitals/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /warehouses/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /deliveryStaff/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{id} {
      allow create, read, update: if isOwner(id) || (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId}/addresses/{addressId} {
      allow read, write: if isOwner(customerId) || isAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /carts/{id} {
      allow read, write: if isOwner(id) || (isAuthenticated() && request.resource.data.customerId == request.auth.uid) || isAdmin();
    }

    match /orders/{id} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.distributorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /shipments/{id} {
      allow read: if isAuthenticated() && (
        resource.data.destinationId == request.auth.uid ||
        resource.data.sourceId == request.auth.uid ||
        resource.data.distributorId == request.auth.uid ||
        resource.data.assignedDeliveryStaffId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /trackingEvents/{id} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }

    match /inventory/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.ownerId == request.auth.uid && request.resource.data.reservedQuantity == resource.data.reservedQuantity)
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /drugs/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || getUserRole() in ['MANUFACTURER','ADMIN']);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.manufacturerId == request.auth.uid);
    }

    match /drugBatches/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || getUserRole() in ['MANUFACTURER','ADMIN']);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.manufacturerId == request.auth.uid);
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || getUserRole() in ['MANUFACTURER','ADMIN']);
    }

    match /catalogue/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /{collection}/{id} {
      allow read, write: if isAdmin();
    }
  }
}

