{
  "name": "drugtrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:emulator": "vite --mode emulator --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "oxlint",
    "seed:emulator": "firebase emulators:exec --only auth,firestore \"node functions/emulator-seed.js\"",
    "seed:emulator:running": "node functions/emulator-seed.js",
    "test:emulator:workflow": "firebase emulators:exec --only auth,firestore,functions \"node functions/emulator-workflow-test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.35.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  }
}
